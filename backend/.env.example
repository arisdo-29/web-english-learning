# Cấu hình Cổng Backend
PORT=5000

# URL của Frontend để cấu hình CORS (thêm domain Vercel của bạn tại đây)
FRONTEND_URL=http://localhost:5173,https://your-app.vercel.app

# DATABASE_URL:
# 1. Để TRỐNG nếu chạy máy nội bộ (Local) -> Hệ thống tự động dùng file JSON DB bền vững, không cần cài đặt gì.
# 2. Điền chuỗi kết nối Supabase / Neon (100% Miễn phí):
#    Ví dụ Supabase: postgresql://postgres:YOUR_PASSWORD@db.xxx.supabase.co:5432/postgres
#    Ví dụ Neon: postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require
DATABASE_URL=

# (Tuỳ chọn) API Key AI trên Server nếu không muốn client nhập:
GEMINI_API_KEY=
GROQ_API_KEY=
